# ==============================================================================
# DevDocs AI — Environment Configuration Template
# ==============================================================================
# NOTE: Safe placeholders only. Never commit real keys or production secrets.
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# --- API Service Configuration (Phase 1) ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Web Frontend Configuration (Phase 1) ---
VITE_API_BASE_URL=http://localhost:4000

# --- Database & Vector Storage (Phase 2) ---
# Default Docker container URL: postgresql://devdocs:devdocs_password@localhost:5432/devdocs_ai
# Default local Postgres.app URL: postgresql://localhost:5433/devdocs_ai
DATABASE_URL=postgresql://devdocs:devdocs_password@localhost:5432/devdocs_ai
TEST_DATABASE_URL=postgresql://devdocs:devdocs_password@localhost:5432/devdocs_ai_test

# --- Authentication & Tenant RBAC (Phase 3) ---
# In production, use a high-entropy secret >= 32 characters:
JWT_SECRET=replace_with_a_secure_random_secret_in_production_32_bytes_min

# ==============================================================================
# DEFERRED PHASE PLACEHOLDERS
# The variables below are documented here for architecture visibility,
# but are NOT required or active during Phase 1-3.
# ==============================================================================

